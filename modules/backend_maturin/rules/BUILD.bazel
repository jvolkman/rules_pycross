load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "maturin_build",
    srcs = ["maturin_build.bzl"],
    deps = [
        "//private:rust_layer",
        "@rules_pycross//pycross:backend",
    ],
)

bzl_library(
    name = "setuptools_rust_build",
    srcs = ["setuptools_rust_build.bzl"],
    deps = [
        "//private:rust_layer",
        "@rules_pycross//pycross:backend",
    ],
)

bzl_library(
    name = "generate_cargo_lock",
    srcs = ["generate_cargo_lock.bzl"],
    deps = [
        "//private:rust_layer",
    ],
)
