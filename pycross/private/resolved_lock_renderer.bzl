"""Pure Starlark implementation of the resolved_lock_renderer.

This module generates the BUILD.bazel content for the `_lock` repository.
It uses PEP 508 marker expressions for platform-conditional dependencies
and a wheel chooser for platform-specific wheel selection.

Naming conventions for generated targets:
  - `_raw_<pkg_key>`: The underlying `pycross_wheel_library` (or
    `pycross_resettable_wheel_library` when variant reset applies) target.
  - `<pkg_key>`: For cycle members, this is a `pycross_library_proxy` (planned at
    repo-rule time in `lock_render/cycles.bzl`) that wraps the raw target and adds
    unconditional and conditional in-cycle deps.
    For extras-only packages (e.g., `name[extra]@version`), this is a `pycross_library_proxy`
    with `actual` pointing to the base package and extra-specific deps in `deps`.
  - `<pkg_name>[_all_]@<version>`: A synthetic `pycross_library_proxy` that aggregates the
    base package and all of its parsed extras into a single target.
"""

load("//pycross/private/lock_render:common.bzl", "ind")
load("//pycross/private/lock_render:cycles.bzl", "render_marker_cycle_member_deps")
load("//pycross/private/lock_render:markers.bzl", "collect_unique_markers", "render_marker_evaluators", "render_resolution_marker_evaluators")
load("//pycross/private/lock_render:package.bzl", "render_extras_aggregates", "render_marker_package")
load("//pycross/private/lock_render:reset_plan.bzl", "compute_reset_plan", "conflict_pairs", _render_reset_bzl = "render_reset_bzl")

render_reset_bzl = _render_reset_bzl

def render_lock_bzl_with_meta(lock, repo_map, rctx_name = "", variant_resolvers = None, reset_conflict_sets = None):
    """Renders a lock.bzl file along with generation metadata.

    Args:
        lock: The parsed lock.json dict.
        repo_map: A dict mapping file keys to repo labels.
        rctx_name: The name of the package repository.
        variant_resolvers: Optional list of variant_resolver target labels, or
            dict mapping resolver label -> list of item qualified names.
        reset_conflict_sets: The workspace's conflict sets (lists of qualified
            names). When given, packages that don't depend on the variant
            settings install with them reset (see render_reset_bzl).

    Returns:
        A `struct(content, has_reset)` where `content` is the rendered `lock.bzl`
        string and `has_reset` is True iff `:reset.bzl` is loaded and used.
    """
    packages = lock.get("packages", {})
    cycle_groups = lock.get("cycle_groups", {})

    # Generated code loads from //pycross/private so these rules don't have to be public API.
    pycross_loads = {
        "dist_info.bzl": ["pycross_dist_info"],
        "pep508_evaluator.bzl": ["pycross_pep508_evaluator"],
        "proxy.bzl": ["pycross_library_proxy"],
        "wheel_chooser.bzl": ["pycross_wheel_chooser"],
        "wheel_library.bzl": ["pycross_wheel_library"],
    }

    loads = {}
    reset_plan = None
    gate_lines = []
    if reset_conflict_sets:
        reset_loads = {}
        reset_plan = compute_reset_plan(packages, repo_map, conflict_pairs(reset_conflict_sets), gate_lines, loads = reset_loads)
        if not [p for p in reset_plan.values() if p.ok]:
            reset_plan = None
            gate_lines = []
        else:
            loads.update(reset_loads)

    body_lines = []

    # 1. Marker evaluators for dependency markers (deduped)
    unique_markers = collect_unique_markers(packages)
    render_marker_evaluators(body_lines, unique_markers, variant_resolvers = variant_resolvers)

    # 1b. Resolution-marker evaluators for pin forks
    resolution_marker_exprs = lock.get("resolution_marker_exprs", {})
    render_resolution_marker_evaluators(body_lines, resolution_marker_exprs, variant_resolvers = variant_resolvers, loads = loads)

    # 2. Per-member cycle deps (marker-aware, planned at repo-rule time)
    render_marker_cycle_member_deps(
        body_lines,
        cycle_groups,
        packages,
        variant_resolvers = variant_resolvers,
        unique_markers = unique_markers,
        loads = loads,
    )

    # 2b. Variant reset gates
    body_lines.extend(gate_lines)

    # 3. Packages
    for pkg_key, pkg in sorted(packages.items()):
        render_marker_package(body_lines, pkg_key, pkg, packages, repo_map, rctx_name, reset_plan = reset_plan, loads = loads)

    # 4. Extras aggregates ([_all_] targets)
    render_extras_aggregates(body_lines, packages)

    if loads.get("cycle_dep_needed"):
        pycross_loads["cycle_dep_needed.bzl"] = ["pycross_cycle_dep_needed"]
    if loads.get("wheel_matched"):
        pycross_loads["wheel_chooser.bzl"].append("pycross_wheel_matched")

    lines = [
        "# This file is generated by rules_pycross.",
        "# It is not intended for manual editing.",
        '"""Pycross-generated dependency targets."""',
        "",
    ] + [
        "load({}, {})".format(
            json.encode("@rules_pycross//pycross/private:" + bzl),
            ", ".join([json.encode(sym) for sym in symbols]),
        )
        for bzl, symbols in sorted(pycross_loads.items())
    ]

    has_reset = bool(reset_plan)
    if has_reset:
        lines.append('load(":reset.bzl", "pycross_resettable_wheel_library")')
    if loads.get("selects"):
        lines.append('load("@bazel_skylib//lib:selects.bzl", "selects")')

    lines.extend([
        "",
        "# buildifier: disable=unnamed-macro",
        "def targets():",
        ind('"""Generated package targets."""'),
        "",
    ])
    lines.extend(body_lines)

    return struct(
        content = "\n".join(lines) + "\n",
        has_reset = has_reset,
    )

def render_lock_bzl(lock, repo_map, rctx_name = "", variant_resolvers = None, reset_conflict_sets = None):
    """Renders a lock.bzl file from a resolved lock structure.

    Args:
        lock: The parsed lock.json dict.
        repo_map: A dict mapping file keys to repo labels.
        rctx_name: The name of the package repository.
        variant_resolvers: Optional list of variant_resolver target labels, or
            dict mapping resolver label -> list of item qualified names.
        reset_conflict_sets: The workspace's conflict sets (lists of qualified
            names). When given, packages that don't depend on the variant
            settings install with them reset (see render_reset_bzl).

    Returns:
        A string containing the rendered lock.bzl file.
    """
    return render_lock_bzl_with_meta(
        lock,
        repo_map,
        rctx_name = rctx_name,
        variant_resolvers = variant_resolvers,
        reset_conflict_sets = reset_conflict_sets,
    ).content
