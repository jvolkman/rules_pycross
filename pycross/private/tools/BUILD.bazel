load("@rules_pycross_internal//:python.bzl", "py_binary", "py_library")
load("//pycross/private:wheel_zipimport_library.bzl", "pycross_wheel_zipimport_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "git_archive.py",
    "inspect_package.py",
])

py_library(
    name = "git_archive",
    srcs = ["git_archive.py"],
)

py_library(
    name = "inspect_package",
    srcs = ["inspect_package.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//pycross/private/patching",
    ],
)

pycross_wheel_zipimport_library(
    name = "installer",
    wheel = "@pycross_internal_deps//installer:wheel",
)

py_binary(
    name = "wheel_installer",
    srcs = ["wheel_installer.py"],
    imports = ["../../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":inspect_package",
        ":installer",
        "//pycross/private/patching",
    ],
)

py_binary(
    name = "wheel_file_op",
    srcs = ["wheel_file_op.py"],
    visibility = ["//visibility:public"],
)
