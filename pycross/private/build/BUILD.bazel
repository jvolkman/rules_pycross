load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "resource_sets",
    srcs = ["resource_sets.bzl"],
    deps = [
        "@bazel_lib//lib:resource_sets",
        "@bazel_skylib//rules:common_settings",
    ],
)

bzl_library(
    name = "cc_pkg_config",
    srcs = ["cc_pkg_config.bzl"],
    deps = [
        ":cc_toolchain_util",
        "@bazel_skylib//lib:collections",
        "@rules_cc//cc/common",
    ],
)

bzl_library(
    name = "repaired_wheel",
    srcs = ["repaired_wheel.bzl"],
    deps = [
        ":cc_toolchain_util",
        "//pycross/private:providers",
        "//pycross/private/build/actions:repair_action",
    ],
)

bzl_library(
    name = "wheel_headers",
    srcs = ["wheel_headers.bzl"],
    deps = [
        ":cc_toolchain_util",
        "//pycross/private:providers",
    ],
)

bzl_library(
    name = "cc_toolchain_util",
    srcs = ["cc_toolchain_util.bzl"],
    deps = [
        "@bazel_skylib//lib:collections",
        "@rules_cc//cc:action_names_bzl",
        "@rules_cc//cc:find_cc_toolchain_bzl",
        "@rules_cc//cc/common",
    ],
)

bzl_library(
    name = "transitions",
    srcs = ["transitions.bzl"],
    deps = [
        "//pycross/private:pep508_marker_values",  # keep
        "@rules_pycross_internal_config//:defaults",
    ],
)
