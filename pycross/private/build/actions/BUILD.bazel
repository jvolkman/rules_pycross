load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "cc_layer",
    srcs = ["cc_layer.bzl"],
    deps = [
        "//pycross/private/build:cc_toolchain_util",
        "@rules_cc//cc:find_cc_toolchain_bzl",
        "@rules_cc//cc/common",
    ],
)

bzl_library(
    name = "pep517_action",
    srcs = ["pep517_action.bzl"],
    deps = [
        "//pycross/private:providers",
        "@bazel_skylib//lib:paths",
        "@pypackaging.bzl//:pypackaging",
        "@rules_python//python:py_info_bzl",
    ],
)

bzl_library(
    name = "repair_action",
    srcs = ["repair_action.bzl"],
    deps = [
        ":pep517_action",
        "//pycross/private/build:cc_toolchain_util",
        "//pycross/private/build:wheel_shared_libraries",
        "@bazel_skylib//lib:collections",
        "@rules_cc//cc/common",
    ],
)

bzl_library(
    name = "tool_extract",
    srcs = ["tool_extract.bzl"],
    deps = [
        "//pycross/private:providers",
        "@bazel_skylib//lib:paths",
    ],
)
