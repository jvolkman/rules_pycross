load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_pycross_internal_config//:defaults.bzl", "glibc_version", "macos_version", "musl_version")
load(
    "//pycross/private:pep508_marker_values.bzl",
    "DEFAULT_PEP508_IMPLEMENTATION_NAME",
    "DEFAULT_PEP508_PLATFORM_PYTHON_IMPLEMENTATION",
    "DEFAULT_PEP508_PLATFORM_RELEASE",
    "DEFAULT_PEP508_PLATFORM_VERSION",
)
load("//pycross/private/build:resource_sets.bzl", _create_settings = "create_resource_set_settings")

package(default_visibility = ["//visibility:public"])

_create_settings()

# Configurable PEP 508 Markers
string_flag(
    name = "pep508_implementation_name",
    build_setting_default = DEFAULT_PEP508_IMPLEMENTATION_NAME,
    scope = "target",
)

string_flag(
    name = "pep508_platform_python_implementation",
    build_setting_default = DEFAULT_PEP508_PLATFORM_PYTHON_IMPLEMENTATION,
    scope = "target",
)

string_flag(
    name = "pep508_platform_release",
    build_setting_default = DEFAULT_PEP508_PLATFORM_RELEASE,
    scope = "target",
)

string_flag(
    name = "pep508_platform_version",
    build_setting_default = DEFAULT_PEP508_PLATFORM_VERSION,
    scope = "target",
)

# Target Environment Constraints
# Defaults come from pycross.configure_toolchains().

# The target's glibc version; wheels tagged up to it (manylinux_2_X) are accepted.
string_flag(
    name = "glibc_version",
    build_setting_default = glibc_version,
    scope = "target",
)

# The target's macOS version; wheels tagged up to it (macosx_X_Y) are accepted.
string_flag(
    name = "macos_version",
    build_setting_default = macos_version,
    scope = "target",
)

# The target's musl version; wheels tagged up to it (musllinux_1_X) are accepted.
string_flag(
    name = "musl_version",
    build_setting_default = musl_version,
    scope = "target",
)

# Unavailable Package Mode
# Controls how packages without a compatible wheel (and no sdist), or fork/variant
# selects without a matching branch, behave:
# - "incompatible" (default): the target is marked @platforms//:incompatible.
# - "fail_at_execution": the target analyzes successfully and registers an action
#   that fails when executed. Useful for analysis-only consumers such as aspects.
string_flag(
    name = "unavailable_package_mode",
    build_setting_default = "incompatible",
    values = [
        "incompatible",
        "fail_at_execution",
    ],
)

config_setting(
    name = "unavailable_package_fail_at_execution",
    flag_values = {":unavailable_package_mode": "fail_at_execution"},
)

# Venv Import Index Mode
# Controls whether binaries resolve imports from their wheel roots through an
# import index finder instead of symlinking wheel contents into site-packages:
# - "off" (default): standard sys.path / venv_symlinks behavior.
# - "scan": index wheel roots at startup (one os.scandir per root).
# - "prebuilt": resolve imports from build-time per-wheel / merged indexes.
string_flag(
    name = "venv_import_index",
    build_setting_default = "off",
    values = [
        "off",
        "scan",
        "prebuilt",
    ],
)
