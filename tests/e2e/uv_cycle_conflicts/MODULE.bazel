bazel_dep(name = "rules_pycross", version = "0.0.0")
bazel_dep(name = "rules_pycross_e2e_shared", version = "0.0.0")
bazel_dep(name = "rules_python", version = "2.0.0")

local_path_override(
    module_name = "rules_pycross",
    path = "../../..",
)

local_path_override(
    module_name = "rules_pycross_e2e_shared",
    path = "../shared",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.14.2",
)

uv = use_extension("@rules_pycross//pycross/extensions:uv.bzl", "uv")
uv.workspace(
    name = "ws",
    local_wheels = [
        "//:above-1.0.0-py3-none-any.whl",
        "//:cyc_p-1.0.0-py3-none-any.whl",
        "//:cyc_q-1.0.0-py3-none-any.whl",
        "//:cyc_x-1.0.0-py3-none-any.whl",
        "//:cyc_y-1.0.0-py3-none-any.whl",
    ],
    lock_file = "//:uv.lock",
)
uv.repo(
    name = "cpu_only",
    dependency_groups = [
        "default",
        "optional:cpu",
    ],
    projects = ["app"],
    workspace = "ws",
)
uv.repo(
    name = "gpu_only",
    dependency_groups = [
        "default",
        "optional:gpu",
    ],
    projects = ["app"],
    workspace = "ws",
)
use_repo(uv, "cpu_only", "gpu_only")
