bazel_dep(name = "bazel_lib", version = "3.2.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_pycross", version = "0.0.0")
bazel_dep(name = "rules_pycross_e2e_shared", version = "0.0.0")
bazel_dep(name = "rules_python", version = "2.0.0")

local_path_override(
    module_name = "rules_pycross",
    path = "../../..",
)

local_path_override(
    module_name = "rules_pycross_e2e_shared",
    path = "../shared",
)

# rules_python
python = use_extension("@rules_python//python/extensions:python.bzl", "python")

# The default is not the latest registered version, to make sure nothing assumes latest == default.
# Nothing builds or tests on 3.15.
python.toolchain(
    is_default = True,
    python_version = "3.14.2",
)
python.toolchain(python_version = "3.10.11")
python.toolchain(python_version = "3.11.6")
python.toolchain(python_version = "3.12.0")
python.toolchain(python_version = "3.15.0")

# Python 3.15.0 isn't in rules_python 2.0.0's built-in tables, so this also checks that pycross handles
# versions added with python.single_version_override (run.sh). Nothing builds or tests on it.
python.single_version_override(
    python_version = "3.15.0",
    sha256 = {
        "aarch64-apple-darwin": "3fb079450ee57075a790b94634206759501166e0a99de459cdad095f6c158d39",
        "x86_64-unknown-linux-gnu": "95ba085863806dacf0fd7119c590154bbcd3351099e55c0808a9c61603e320a8",
    },
    urls = ["https://github.com/astral-sh/python-build-standalone/releases/download/20261009/cpython-{python_version}+20261009-{platform}-{build}.{ext}"],
)
use_repo(python, "python_versions")

uv = use_extension("@rules_pycross//pycross/extensions:uv.bzl", "uv")
uv.workspace(
    name = "uv",
    lock_file = "//:uv.lock",
)
uv.repo(
    workspace = "uv",
)
uv.package(
    name = "python-dateutil",
    precompile = "enabled",
    workspace = "uv",
)
use_repo(uv, "uv")
