load("@uv//:requirements.bzl", "all_requirements")

# rerun-sdk 0.33.0 (used for Python >= 3.10) has no macOS x86_64 wheel and no sdist, so it is
# unavailable on this platform. run.sh uses it to check unavailable_package_mode behavior.
platform(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

# These are filegroups rather than py_binary: a py_binary would resolve a C++ toolchain for
# this platform and fetch the macOS SDK.

# Depends directly on the unavailable package.
filegroup(
    name = "uses_rerun",
    srcs = ["@uv//rerun_sdk:pkg"],
)

# Aggregates leave out packages that are unavailable on the target platform.
filegroup(
    name = "uses_all_requirements",
    srcs = all_requirements,
)
