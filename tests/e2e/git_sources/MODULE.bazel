bazel_dep(name = "rules_pycross", version = "0.0.0")
bazel_dep(name = "rules_pycross_e2e_shared", version = "0.0.0")
bazel_dep(name = "rules_python", version = "2.0.0")

local_path_override(
    module_name = "rules_pycross",
    path = "../../..",
)

local_path_override(
    module_name = "rules_pycross_e2e_shared",
    path = "../shared",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11.6",
)
use_repo(python, "python_versions")

# run.sh generates both locks from uv.lock.in, pointing at git fixtures it
# creates under a temporary directory.
uv = use_extension("@rules_pycross//pycross/extensions:uv.bzl", "uv")
uv.workspace(
    name = "uv",
    lock_file = "//:uv.lock",
)
uv.repo(
    workspace = "uv",
)
uv.workspace(
    name = "uv_lfs",
    lock_file = "//:uv_lfs.lock",
)
uv.repo(
    workspace = "uv_lfs",
)
use_repo(uv, "uv", "uv_lfs")
