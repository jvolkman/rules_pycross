bazel_dep(name = "rules_pycross", version = "0.0.0")
bazel_dep(name = "rules_pycross_e2e_shared", version = "0.0.0")
bazel_dep(name = "rules_python", version = "2.0.0")

local_path_override(
    module_name = "rules_pycross",
    path = "../../..",
)

local_path_override(
    module_name = "rules_pycross_e2e_shared",
    path = "../shared",
)

# rules_python
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.14.2",
)
python.toolchain(python_version = "3.11.6")
python.toolchain(python_version = "3.12.0")
use_repo(python, "python_versions")

uv = use_extension("@rules_pycross//pycross/extensions:uv.bzl", "uv")
uv.workspace(
    name = "shared",
    lock_file = "//:uv.lock",
)
uv.repo(
    name = "lock_all",
    projects = ["*"],
    workspace = "shared",
)

# Override project-a's repo name; project-b uses the pattern default (lock_project_b).
uv.repo(
    name = "lock_a",
    projects = ["project-a"],
    workspace = "shared",
)
uv.repo(
    name = "lock_project_b",
    projects = ["project-b"],
    workspace = "shared",
)

# Annotation conflict: exclude a test file from regex across the whole workspace.
uv.package(
    name = "regex",
    install_exclude_globs = ["test_regex.py"],
    workspace = "shared",
)

# Both members declare a conflicting `test` group with the same name. Each
# member repo exposes its own as `group_test` and pins it.
uv.repo(
    name = "lock_a_test",
    dependency_groups = ["group:test;testonly"],
    flags = ["--@lock_a_test//_variants:group_test=True"],
    projects = ["project-a"],
    workspace = "shared",
)
uv.repo(
    name = "lock_b_test",
    dependency_groups = ["group:test;testonly"],
    flags = ["--@lock_b_test//_variants:group_test=True"],
    projects = ["project-b"],
    workspace = "shared",
)

# A repo covering both members: `group_test` would enable both (conflicting)
# `test` groups, so pick one member's with its per-project flag.
uv.repo(
    name = "lock_all_test",
    dependency_groups = ["group:test;testonly"],
    flags = ["--@lock_all_test//_variants:group_project-a_test=True"],
    projects = ["*"],
    workspace = "shared",
)

# No flags: project-a's `default-groups = ["test"]` makes its `test` group this
# repo's default (applied by the repo's transition).
uv.repo(
    name = "lock_a_test_default",
    dependency_groups = ["group:test;testonly"],
    projects = ["project-a"],
    workspace = "shared",
)
use_repo(uv, "lock_a", "lock_a_test", "lock_a_test_default", "lock_all", "lock_all_test", "lock_b_test", "lock_project_b")

# Test standalone members (no uv_all_members)
uv.workspace(
    name = "standalone",
    lock_file = "//:uv.lock",
)
uv.repo(
    name = "lock_standalone_a",
    projects = ["project-a"],
    workspace = "standalone",
)
uv.repo(
    name = "lock_standalone_b",
    projects = ["project-b"],
    workspace = "standalone",
)
use_repo(uv, "lock_standalone_a", "lock_standalone_b")
