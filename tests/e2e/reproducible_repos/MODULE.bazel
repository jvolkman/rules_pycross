bazel_dep(name = "rules_pycross", version = "0.0.0")
bazel_dep(name = "rules_python", version = "2.0.0")

local_path_override(
    module_name = "rules_pycross",
    path = "../../..",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11.6",
)

uv = use_extension("@rules_pycross//pycross/extensions:uv.bzl", "uv")
uv.workspace(
    name = "uv",
    lock_file = "//:uv.lock",
)
uv.repo(
    workspace = "uv",
)
use_repo(uv, "uv")
