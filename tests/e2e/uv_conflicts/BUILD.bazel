load("@project_pinned//:requirements.bzl", pinned_all_requirements = "all_requirements")
load("@rules_python//python:defs.bzl", "py_test")

# Platforms that select conflict variants via bool_flag settings.
# @project//_variants:extra_variant-a and @project//_variants:extra_variant-b
# are bool_flags generated by pycross from the uv conflict declarations.

platform(
    name = "plat_variant_a",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    flags = [
        "--@project//_variants:extra_variant-a=True",
    ],
)

platform(
    name = "plat_variant_b",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    flags = [
        "--@project//_variants:extra_variant-b=True",
    ],
)

platform(
    name = "plat_windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

# Test that variant-a resolves typing_extensions 4.11.0 and jinja2 3.1.6 -> markupsafe 3.0.4 (via uv conflict marker).
py_test(
    name = "test_variant_a",
    srcs = ["tests/test_conflict_version.py"],
    args = [
        "typing-extensions",
        "4.11.0",
        "jinja2",
        "3.1.6",
        "markupsafe",
        "3.0.4",
    ],
    main = "tests/test_conflict_version.py",
    deps = [
        "@project//jinja2",
        "@project//typing_extensions",
    ],
)

