load("@project_pinned//:requirements.bzl", pinned_all_requirements = "all_requirements")
load("@rules_python//python:defs.bzl", "py_test")

# Platforms that select conflict variants via bool_flag settings.
# @project//_variants:extra_variant-a and @project//_variants:extra_variant-b
# are bool_flags generated by pycross from the uv conflict declarations.

platform(
    name = "plat_variant_a",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    flags = [
        "--@project//_variants:extra_variant-a=True",
    ],
)

platform(
    name = "plat_variant_b",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    flags = [
        "--@project//_variants:extra_variant-b=True",
    ],
)

# Test that variant-a resolves typing_extensions 4.11.0.
py_test(
    name = "test_variant_a",
    srcs = ["tests/test_conflict_version.py"],
    args = [
        "typing-extensions",
        "4.11.0",
    ],
    main = "tests/test_conflict_version.py",
    deps = ["@project//typing_extensions"],
)

# Test that variant-b resolves typing_extensions 4.12.2.
py_test(
    name = "test_variant_b",
    srcs = ["tests/test_conflict_version.py"],
    args = [
        "typing-extensions",
        "4.12.2",
    ],
    main = "tests/test_conflict_version.py",
    deps = ["@project//typing_extensions"],
)

# Test that default-groups makes group-a the default:
# idna should resolve to 3.7 without any flags because group-a is the default.
py_test(
    name = "test_default_group",
    srcs = ["tests/test_conflict_version.py"],
    args = [
        "idna",
        "3.7",
    ],
    main = "tests/test_conflict_version.py",
    deps = ["@project//idna"],
)

# Test that @project_pinned resolves variant-a via platform transition.
# This repo has flags = ["--@project_pinned//_variants:extra_variant-a=True"]
# in its member import, so it should resolve typing-extensions 4.11.0
# without any CLI --flag arguments.
py_test(
    name = "test_transition_pinned",
    srcs = ["tests/test_conflict_version.py"],
    args = [
        "typing-extensions",
        "4.11.0",
    ],
    main = "tests/test_conflict_version.py",
    deps = ["@project_pinned//typing_extensions"],
)

# Test that @project_pinned//:requirements.bzl all_requirements (which uses
# @project_pinned//typing_extensions:maybe because typing-extensions has an
# availability marker) evaluates its variant and availability selects after the
# repo transition, resolving typing-extensions 4.11.0 without CLI --flag args.
py_test(
    name = "test_transition_pinned_maybe",
    srcs = ["tests/test_conflict_version.py"],
    args = [
        "typing-extensions",
        "4.11.0",
    ],
    main = "tests/test_conflict_version.py",
    deps = pinned_all_requirements,
)

# Test that @project_flags (flags only, no constraint_values or platform)
# keeps the incoming --platforms and applies the pinned variant flag.
py_test(
    name = "test_transition_flags_only",
    srcs = ["tests/test_conflict_version.py"],
    args = [
        "typing-extensions",
        "4.11.0",
    ],
    main = "tests/test_conflict_version.py",
    deps = ["@project_flags//typing_extensions"],
)

# Test that @project_settings pins the variant via `settings` (a label-keyed
# dict resolved relative to this module) instead of `flags`.
py_test(
    name = "test_transition_settings",
    srcs = ["tests/test_conflict_version.py"],
    args = [
        "typing-extensions",
        "4.11.0",
    ],
    main = "tests/test_conflict_version.py",
    deps = ["@project_settings//typing_extensions"],
)

# The generated modules_mapping targets must be analyzed under the repo's
# transition so their variant selects resolve without CLI flags.
filegroup(
    name = "transition_modules_mappings",
    srcs = [
        "@project_flags//:modules_mapping",
        "@project_pinned//:modules_mapping",
    ],
)
