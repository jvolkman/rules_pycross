bazel_dep(name = "rules_pycross", version = "0.0.0")
bazel_dep(name = "rules_pycross_e2e_shared", version = "0.0.0")
bazel_dep(name = "rules_python", version = "2.0.0")
bazel_dep(name = "platforms", version = "0.0.10")

local_path_override(
    module_name = "rules_pycross",
    path = "../../..",
)

local_path_override(
    module_name = "rules_pycross_e2e_shared",
    path = "../shared",
)

# rules_python
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.14.2",
)
python.toolchain(python_version = "3.11.6")
python.toolchain(python_version = "3.12.0")
use_repo(python, "python_versions")

config = use_extension("@rules_python//python/extensions:config.bzl", "config")
config.add_transition_setting(setting = "@project//_variants")
config.add_transition_setting(setting = "@extras_multi//_variants")

uv = use_extension("@rules_pycross//pycross/extensions:uv.bzl", "uv")
uv.workspace(
    name = "shared",
    lock_file = "//:uv.lock",
)
uv.repo(
    name = "project",
    dependency_groups = [
        "default",
        "group:group-a",
        "group:group-b",
        "optional:variant-a",
        "optional:variant-b",
    ],
    projects = ["project"],
    workspace = "shared",
)
uv.repo(
    name = "project_pinned",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    dependency_groups = [
        "default",
        "group:group-a",
        "group:group-b",
        "optional:variant-a",
        "optional:variant-b",
    ],
    flags = [
        "--@project_pinned//_variants:extra_variant-a=True",
    ],
    projects = ["project"],
    workspace = "shared",
)
uv.repo(
    name = "project_flags",
    dependency_groups = [
        "default",
        "group:group-a",
        "group:group-b",
        "optional:variant-a",
        "optional:variant-b",
    ],
    flags = [
        "--@project_flags//_variants:extra_variant-a=True",
    ],
    projects = ["project"],
    workspace = "shared",
)
uv.repo(
    name = "project_settings",
    dependency_groups = [
        "default",
        "group:group-a",
        "group:group-b",
        "optional:variant-a",
        "optional:variant-b",
    ],
    projects = ["project"],
    settings = {
        "@project_settings//_variants:extra_variant-a": "True",
    },
    workspace = "shared",
)
uv.repo(
    name = "project_str_flags",
    dependency_groups = [
        "default",
        "group:group-a",
        "group:group-b",
        "optional:variant-a",
        "optional:variant-b",
    ],
    flags = [
        "--@project_str_flags//_variants=extra_variant-a,group_group-b",
    ],
    projects = ["project"],
    workspace = "shared",
)
uv.repo(
    name = "project_str_settings",
    dependency_groups = [
        "default",
        "group:group-a",
        "group:group-b",
        "optional:variant-a",
        "optional:variant-b",
    ],
    projects = ["project"],
    settings = {
        "@project_str_settings//_variants": "extra_variant-b",
    },
    workspace = "shared",
)

# Requests only `variant-a` of the extras conflict, so it selects it without flags.
uv.repo(
    name = "project_auto",
    dependency_groups = [
        "default",
        "optional:variant-a",
    ],
    projects = ["project"],
    workspace = "shared",
)

# Per-repo and per-variant extras isolation: alpha requests wrapper[v1] -> idna==3.7,
# while beta requests wrapper bare + idna==3.10.
uv.workspace(
    name = "extras_ws",
    local_wheels = ["//extras_isolation:wrapper-1.0.0-py3-none-any.whl"],
    lock_file = "//extras_isolation:uv.lock",
)
uv.repo(
    name = "extras_alpha",
    dependency_groups = [
        "default",
        "optional:alpha",
    ],
    projects = ["extras-isolation"],
    workspace = "extras_ws",
)
uv.repo(
    name = "extras_beta",
    dependency_groups = [
        "default",
        "optional:beta",
    ],
    projects = ["extras-isolation"],
    workspace = "extras_ws",
)
uv.repo(
    name = "extras_multi",
    dependency_groups = [
        "default",
        "optional:alpha",
        "optional:beta",
    ],
    projects = ["extras-isolation"],
    workspace = "extras_ws",
)
use_repo(
    uv,
    "extras_alpha",
    "extras_beta",
    "extras_multi",
    "project",
    "project_auto",
    "project_flags",
    "project_pinned",
    "project_settings",
    "project_str_flags",
    "project_str_settings",
)
