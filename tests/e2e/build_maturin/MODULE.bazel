include("//shared:llvm.MODULE.bazel")

bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_python", version = "2.0.0")
bazel_dep(name = "rules_pycross", version = "0.0.0")
bazel_dep(name = "rules_pycross_backend_maturin", version = "0.0.0")
bazel_dep(name = "bazel_lib", version = "3.2.0")
bazel_dep(name = "rules_rust", version = "0.68.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)

local_path_override(
    module_name = "rules_pycross",
    path = "../../..",
)

local_path_override(
    module_name = "rules_pycross_backend_maturin",
    path = "../../../modules/backend_maturin",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.14.2",
)

# Python 3.15.0 isn't in rules_python 2.0.0's built-in tables; register it from
# python-build-standalone. run.sh cross-builds python-geohash (an abi3 extension) with it.
python.single_version_override(
    python_version = "3.15.0",
    sha256 = {
        "aarch64-apple-darwin": "3fb079450ee57075a790b94634206759501166e0a99de459cdad095f6c158d39",
        "x86_64-unknown-linux-gnu": "95ba085863806dacf0fd7119c590154bbcd3351099e55c0808a9c61603e320a8",
    },
    urls = ["https://github.com/astral-sh/python-build-standalone/releases/download/20261009/cpython-{python_version}+20261009-{platform}-{build}.{ext}"],
)
python.toolchain(python_version = "3.15.0")
use_repo(python, "python_versions")

pycross = use_extension("@rules_pycross//pycross/extensions:pycross.bzl", "pycross")
pycross.configure_toolchains(
    platforms = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
    python_versions = [
        "3.14.2",
        "3.15.0",
    ],
)

uv = use_extension("@rules_pycross//pycross/extensions:uv.bzl", "uv")
uv.workspace(
    name = "uv",
    lock_file = "//:uv.lock",
)
uv.repo(
    dependency_groups = [
        "default",
        "transitive",
    ],
    workspace = "uv",
)
uv.package(
    name = "rpds-py",
    build_mode = "always",
    workspace = "uv",
)
uv.package(
    name = "jiter",
    build_mode = "always",
    workspace = "uv",
)
uv.package(
    name = "python-geohash",
    build_mode = "always",
    workspace = "uv",
)

maturin = use_extension("@rules_pycross_backend_maturin//extensions:maturin.bzl", "maturin")
maturin.override(
    name = "jiter",
    cargo_lock = "//:jiter.lock",
    workspace = "uv",
)

use_repo(uv, "uv")
