load("@rules_python//python:defs.bzl", "py_test")

py_test(
    name = "test_runtime_cpu",
    srcs = ["tests/test_conflict_version.py"],
    args = [
        "iniconfig",
        "1.1.1",
    ],
    main = "tests/test_conflict_version.py",
    deps = ["@runtime//iniconfig"],
)

py_test(
    name = "test_runtime_gpu",
    srcs = ["tests/test_conflict_version.py"],
    args = [
        "iniconfig",
        "2.0.0",
    ],
    main = "tests/test_conflict_version.py",
    deps = ["@runtime//iniconfig"],
)

py_test(
    name = "test_cpu_only",
    srcs = ["tests/test_conflict_version.py"],
    args = [
        "iniconfig",
        "1.1.1",
    ],
    main = "tests/test_conflict_version.py",
    deps = ["@cpu_only//iniconfig"],
)

# The same package through two repos in different configurations (`cpu_only`
# is pinned, `runtime` isn't). The venv must still contain it.
py_test(
    name = "test_diamond",
    srcs = ["tests/test_conflict_version.py"],
    args = [
        "iniconfig",
        "1.1.1",
    ],
    main = "tests/test_conflict_version.py",
    deps = [
        "@cpu_only//iniconfig",
        "@runtime//iniconfig",
    ],
)

# pytest's edges to iniconfig are conflict-gated. In `gpu_only` it must get
# 2.0.0, even when another repo's flag selects `cpu`.
py_test(
    name = "test_gpu_only_pytest",
    srcs = ["tests/test_conflict_version.py"],
    args = [
        "iniconfig",
        "2.0.0",
    ],
    main = "tests/test_conflict_version.py",
    deps = ["@gpu_only//pytest"],
)

py_test(
    name = "test_gpu_dev_pytest",
    srcs = ["tests/test_conflict_version.py"],
    args = [
        "iniconfig",
        "2.0.0",
    ],
    main = "tests/test_conflict_version.py",
    deps = [
        "@gpu_dev//iniconfig",
        "@gpu_dev//pytest",
    ],
)
