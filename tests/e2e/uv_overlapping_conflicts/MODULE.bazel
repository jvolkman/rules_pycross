bazel_dep(name = "rules_pycross", version = "0.0.0")
bazel_dep(name = "rules_pycross_e2e_shared", version = "0.0.0")
bazel_dep(name = "rules_python", version = "2.0.0")

local_path_override(
    module_name = "rules_pycross",
    path = "../../..",
)

local_path_override(
    module_name = "rules_pycross_e2e_shared",
    path = "../shared",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.14.2",
)

uv = use_extension("@rules_pycross//pycross/extensions:uv.bzl", "uv")
uv.workspace(
    name = "ws",
    lock_file = "//:uv.lock",
)

# Requests `cpu` and `gpu`: the first set needs a flag. The second set
# (`cpu` vs `gpu-test`) must not pin `cpu`, which would conflict with `gpu`.
uv.repo(
    name = "runtime",
    dependency_groups = [
        "default",
        "optional:cpu",
        "optional:gpu",
    ],
    projects = ["app"],
    workspace = "ws",
)

# Requests only `cpu`, so both sets select it without flags.
uv.repo(
    name = "cpu_only",
    dependency_groups = [
        "default",
        "optional:cpu",
    ],
    projects = ["app"],
    workspace = "ws",
)

# Requests only `gpu`, so it's pinned. A flag selecting `cpu` for another repo
# must not reach the second set (`cpu` vs `gpu-test`) here.
uv.repo(
    name = "gpu_only",
    dependency_groups = [
        "default",
        "optional:gpu",
    ],
    projects = ["app"],
    workspace = "ws",
)

# Requests every item, and a flag pins `gpu`. `gpu-test` stays usable in the
# second set, but `cpu` (a rival of the pin) must not be activated there.
uv.repo(
    name = "gpu_dev",
    dependency_groups = [
        "default",
        "optional:cpu",
        "optional:gpu",
        "group:gpu-test",
    ],
    flags = ["--@gpu_dev//_variants:extra_gpu=True"],
    projects = ["app"],
    workspace = "ws",
)
use_repo(uv, "cpu_only", "gpu_dev", "gpu_only", "runtime")
