load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Main-repo native dep with a source include dir and transitive linkopts
# (exercises include-dir absolutization and user_link_flags propagation in the
# cc layer).
cc_library(
    name = "probe_hdr",
    hdrs = ["include/probe_hdr.h"],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:linux": ["-lm"],
        "@platforms//os:macos": [
            "-framework",
            "Security",
        ],
        "//conditions:default": [],
    }),
)
