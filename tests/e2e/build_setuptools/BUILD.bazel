load("@rules_pycross//pycross:defs.bzl", "pycross_wheel_library")
load("@rules_python//python:defs.bzl", "py_binary")
load("@uv//_backend:setuptools_build.bzl", "setuptools_build")
load("//shared:collect_wheels.bzl", "collect_wheels")

package(default_visibility = ["//visibility:public"])

collect_wheels(
    name = "all_wheels",
    platforms = [
        "@llvm//platforms:linux_x86_64",
        "@llvm//platforms:macos_aarch64",
    ],
    wheels = [
        "@uv//psycopg2:wheel",
        "@uv//pyyaml:wheel",
        "@uv//setproctitle:wheel",
        ":distutils_probe_build",
        ":zstandard_build",
    ],
)

py_binary(
    name = "build_distutils_probe_sdist",
    srcs = ["build_distutils_probe_sdist.py"],
)

genrule(
    name = "distutils_probe_sdist",
    srcs = [
        "distutils_probe/distutils_probe_pkg/__init__.py",
        "distutils_probe/pyproject.toml",
        "distutils_probe/setup.py",
    ],
    outs = ["distutils_probe-0.1.tar.gz"],
    cmd = "\"$(location :build_distutils_probe_sdist)\" \"$@\" \"$(location distutils_probe/pyproject.toml)\" \"$(location distutils_probe/setup.py)\" \"$(location distutils_probe/distutils_probe_pkg/__init__.py)\"",
    tools = [":build_distutils_probe_sdist"],
)

setuptools_build(
    name = "distutils_probe_build",
    copts = ["-DPROBE_STR=\"a b\""],
    native_deps = ["//probe_hdr"],
    sdist = ":distutils_probe_sdist",
    tags = ["manual"],
)

pycross_wheel_library(
    name = "distutils_probe",
    wheel = ":distutils_probe_build",
)

setuptools_build(
    name = "zstandard_build",
    config_settings = {
        "--build-option": [
            "--no-cffi-backend",
            "--system-zstd",
        ],
    },
    copts = ["-Wl,-s"],
    native_deps = [
        "//third_party/zstd",
    ],
    sdist = "@uv//zstandard:sdist",
    tags = ["manual"],
)

pycross_wheel_library(
    name = "zstandard",
    wheel = ":zstandard_build",
)
