load("@rules_pycross//pycross:defs.bzl", "pycross_py_binary", "pycross_py_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@uv//:requirements.bzl", "all_requirements", "requirement")

package(default_visibility = ["//visibility:public"])

py_test(
    name = "test_namespace",
    srcs = ["test_namespace.py"],
    deps = all_requirements,
)

py_test(
    name = "test_namespace_direct",
    srcs = ["test_namespace.py"],
    main = "test_namespace.py",
    deps = [
        requirement("google-cloud-storage"),
        requirement("google-cloud-pubsub"),
        requirement("zope.interface"),
        requirement("zope.event"),
    ],
)

py_test(
    name = "test_extras_aliases",
    srcs = ["test_extras_aliases.py"],
    deps = [
        requirement("google-api-core"),
    ],
)

py_test(
    name = "test_pkgutil_namespace",
    srcs = ["test_pkgutil_namespace.py"],
    deps = [
        requirement("backports.entry-points-selectable"),
        requirement("backports.tarfile"),
    ],
)

# Stock first-party py_library sitting between the test targets and the
# pycross_wheel_library fixtures.
py_library(
    name = "first_party_bridge",
    srcs = [
        "azfixture/first_party_ns.py",
        "first_party_mod.py",
    ],
    deps = [
        "//fixtures:azfixture_core",
        "//fixtures:azfixture_core_tracing_plugin",
        "//fixtures:enumfixture",
        "//fixtures:nvidia_fixture_cublas",
        "//fixtures:nvidia_fixture_cudnn",
        "//fixtures:nvidia_fixture_nccl",
        "//fixtures:pthfixture",
        "//fixtures:rpathfixture",
        "//fixtures:sonamefixture",
    ],
)

# Stock py_test using pycross_import_index.pth + per-wheel indexes via venv_symlinks.
py_test(
    name = "test_import_index",
    srcs = ["test_import_index.py"],
    tags = ["manual"],
    deps = [
        ":first_party_bridge",
    ],
)

# pycross_py_test wrapper that pre-merges transitive wheel indexes (through
# first_party_bridge) into a single _bazel_import_index.json via PyMakeVenvIndex.
pycross_py_test(
    name = "test_import_index_merged",
    srcs = ["test_import_index.py"],
    env = {
        "EXPECT_PREMERGED_INDEX_FILE": "1",
    },
    main = "test_import_index.py",
    tags = ["manual"],
    deps = [
        ":first_party_bridge",
    ],
)

# Interactive demo binaries (run with `bazel run --config=index //:demo` or `//:demo_stock`).
pycross_py_binary(
    name = "demo",
    srcs = ["demo.py"],
    tags = ["manual"],
    deps = all_requirements + [
        ":first_party_bridge",
    ],
)

py_binary(
    name = "demo_stock",
    srcs = ["demo.py"],
    main = "demo.py",
    tags = ["manual"],
    deps = all_requirements + [
        ":first_party_bridge",
    ],
)
