load("@rules_pycross//pycross:defs.bzl", "pycross_wheel_library")
load("@rules_python//python:defs.bzl", "py_test")
load("@uv//:requirements.bzl", "all_requirements", "requirement")

package(default_visibility = ["//visibility:public"])

py_test(
    name = "test_namespace",
    srcs = ["test_namespace.py"],
    deps = all_requirements,
)

py_test(
    name = "test_namespace_direct",
    srcs = ["test_namespace.py"],
    main = "test_namespace.py",
    deps = [
        requirement("google-cloud-storage"),
        requirement("google-cloud-pubsub"),
        requirement("zope.interface"),
        requirement("zope.event"),
    ],
)

py_test(
    name = "test_extras_aliases",
    srcs = ["test_extras_aliases.py"],
    deps = [
        requirement("google-api-core"),
    ],
)

py_test(
    name = "test_extras_base_only",
    srcs = ["test_extras_base_only.py"],
    deps = [
        "@uv//google_api_core:[]",
    ],
)

py_test(
    name = "test_pkgutil_namespace",
    srcs = ["test_pkgutil_namespace.py"],
    deps = [
        requirement("backports.entry-points-selectable"),
        requirement("backports.tarfile"),
    ],
)

pycross_wheel_library(
    name = "hybrid_core",
    package_name = "hybrid-core",
    package_version = "1.0.0",
    wheel = "@hybrid_core_whl//:wheel",
)

pycross_wheel_library(
    name = "hybrid_plugin",
    package_name = "hybrid-plugin",
    package_version = "1.0.0",
    wheel = "@hybrid_plugin_whl//:wheel",
)

py_test(
    name = "test_hybrid_namespace",
    srcs = ["test_hybrid_namespace.py"],
    deps = [
        ":hybrid_core",
        ":hybrid_plugin",
    ],
)
