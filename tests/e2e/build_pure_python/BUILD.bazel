# buildifier: disable=bzl-visibility
load("@rules_pycross//pycross/private:wheel_library.bzl", "pycross_wheel_library")
load("@rules_python//python:defs.bzl", "py_test")
load("//shared:collect_wheels.bzl", "collect_wheels")

exports_files(["misleading_pkg-0.1.0.tar.gz"])

collect_wheels(
    name = "all_wheels",
    platforms = [
        "@llvm//platforms:linux_x86_64",
        "@llvm//platforms:macos_aarch64",
    ],
    wheels = [
        "@uv//filelock:wheel",
        "@uv//pyproject_metadata:wheel",
        "@uv//tomli:wheel",
    ],
)

py_test(
    name = "test_top_level_packages",
    srcs = ["@rules_pycross_e2e_shared//:test_top_level_packages.py"],
    env = {
        # Tell the test which packages to check (sdist-built pure Python)
        "PYCROSS_TEST_PACKAGES": "tomli,filelock",
    },
    main = "test_top_level_packages.py",
    deps = [
        "@uv//filelock:pkg",
        "@uv//tomli:pkg",
    ],
)

pycross_wheel_library(
    name = "misleading_pkg",
    package_name = "misleading-pkg",
    package_version = "0.1.0",
    wheel = "@misleading_sdist//:wheel",
)

py_test(
    name = "test_misleading_layout",
    srcs = ["test_misleading_layout.py"],
    deps = [":misleading_pkg"],
)
