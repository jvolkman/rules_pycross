load("//:_transition.bzl", "pycross_transitioning_file_proxy")
load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_pycross//pycross/private:modules_mapping.bzl", "pycross_modules_mapping")
load("@rules_python//python:defs.bzl", "py_library")
package(default_visibility = ["//visibility:public"])

# Empty library for _maybe_ targets on incompatible platforms.
py_library(name = "_empty_library", visibility = ["//:__subpackages__"])

pycross_transitioning_file_proxy(
    name = "modules_mapping",
    actual = ":_modules_mapping",
)

exports_files(["requirements.bzl"])

selects.config_setting_group(
    name = "_mm_any_8fac517f",
    match_any = [
        "@golden_overlapping_conflicts__state//:is_extra_app_x",
        "@golden_overlapping_conflicts__state//:is_group_app_g-b",
    ],
)

selects.config_setting_group(
    name = "_mm_any_1ca705c7",
    match_any = [
        "@golden_overlapping_conflicts__state//:_unselected_extra_app_x_extra_app_y",
        "@golden_overlapping_conflicts__state//:is_extra_app_y",
    ],
)

pycross_modules_mapping(
    name = "_modules_mapping",
    deps = [
        "@golden_overlapping_conflicts__pkg_pytest//:_raw",
    ] + select({
        "//_markers:is_extra_app_x_res_py312": [
            "@golden_overlapping_conflicts__pkg_typing_extensions//:_raw_s0",
        ],
        "//conditions:default": [],
    }) + select({
        ":_mm_any_1ca705c7": [
            "@golden_overlapping_conflicts__pkg_typing_extensions//:_raw_s1",
        ],
        "//conditions:default": [],
    }) + select({
        ":_mm_any_8fac517f": [
            "@golden_overlapping_conflicts__pkg_iniconfig//:_raw_s1",
        ],
        "//conditions:default": [],
    }) + select({
        "@golden_overlapping_conflicts__state//:is_group_app_g-a": [
            "@golden_overlapping_conflicts__pkg_iniconfig//:_raw_s0",
        ],
        "//conditions:default": [],
    }),
)

alias(
    name = "iniconfig",
    actual = "//iniconfig:pkg",
)
alias(
    name = "pytest",
    actual = "//pytest:pkg",
)
alias(
    name = "typing-extensions",
    actual = "//typing_extensions:pkg",
)