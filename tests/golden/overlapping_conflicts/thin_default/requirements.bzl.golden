load("@pypackaging.bzl", "pypackaging")

def requirement(pkg):
    extra = None
    if "[" in pkg:
        pkg, extra = pkg.split("[", 1)
        extra = pypackaging.utils.canonicalize_name(extra.rstrip("]"))

    pkg = pypackaging.utils.canonicalize_name(pkg)
    pkg_dir = pkg.replace("-", "_")

    if extra:
        return "@@golden_overlapping_conflicts//%s:[%s]" % (pkg_dir, extra)
    return "@@golden_overlapping_conflicts//%s" % (pkg_dir)


# All pinned requirements, excluding testonly ones
all_requirements = [
    "@@golden_overlapping_conflicts//iniconfig:maybe",
    "@@golden_overlapping_conflicts//pytest",
    "@@golden_overlapping_conflicts//typing_extensions:maybe",
]

# All testonly pinned requirements
all_testonly_requirements = [
]
