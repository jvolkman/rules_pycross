load("//:_transition.bzl", "pycross_transitioning_file_proxy", "pycross_transitioning_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "pytest",
    actual = ":pkg",
)

pycross_transitioning_library_proxy(
    name = "pkg",
    actual = "@golden_overlapping_conflicts__pkgs//_lock:pytest@7.4.4",
)

pycross_transitioning_file_proxy(
    name = "wheel",
    actual = "@golden_overlapping_conflicts__pkgs//_wheel:pytest@7.4.4",
)

pycross_transitioning_file_proxy(
    name = "dist_info",
    actual = "@golden_overlapping_conflicts__pkgs//_lock:_dist_info_pytest@7.4.4",
)

alias(
    name = "data",
    actual = ":pkg",
)
