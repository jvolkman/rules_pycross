load("//:_transition.bzl", "pycross_transitioning_file_proxy", "pycross_transitioning_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "pytest",
    actual = ":pkg",
)

pycross_transitioning_library_proxy(
    name = "pkg",
    actual = "@golden_overlapping_conflicts__pkg_pytest//:pkg",
)

pycross_transitioning_file_proxy(
    name = "wheel",
    actual = "@golden_overlapping_conflicts__pkg_pytest//:wheel",
)

pycross_transitioning_file_proxy(
    name = "dist_info",
    actual = "@golden_overlapping_conflicts__pkg_pytest//:dist_info",
)

alias(
    name = "data",
    actual = ":pkg",
)
