alias(
    name = "maybe",
    actual = select({
        "@golden_overlapping_conflicts__state//:is_extra_app_x": "//__actual/iniconfig:pkg",
        "@golden_overlapping_conflicts__state//:is_group_app_g-a": "//__actual/iniconfig:pkg",
        "@golden_overlapping_conflicts__state//:is_group_app_g-b": "//__actual/iniconfig:pkg",
        "//_variants:_unselected_all_840c96e5": "//_variants:_no_variant_extra_app_x_group_app_g-a",
        "//conditions:default": "//:_empty_library",
