"""Generated transition rules for golden_overlapping_conflicts with pinned flag values."""

load("@rules_pycross//pycross/private:proxy.bzl", "make_file_proxy_rule", "make_library_proxy_rule")
load("@rules_pycross//pycross/private:variant_util.bzl", "merge_variant_state")

# Variant pins, defaults, and usable narrowing merged over incoming _state.
_VARIANT_STATE_LABEL = "@golden_overlapping_conflicts__pkgs//_lock:_state"

_VARIANT_STATE_OVERRIDES = {
    "d:extra_app_x_group_app_g-a": "group_app_g-a",
    "d:group_app_g-a_group_app_g-b": "group_app_g-a",
    "u:extra_app_x_extra_app_y": "",
    "u:extra_app_x_group_app_g-a": "",
    "u:group_app_g-a_group_app_g-b": "",
}

def _transition_impl(settings, attr):
    result = {}
    result[_VARIANT_STATE_LABEL] = merge_variant_state(settings[_VARIANT_STATE_LABEL], _VARIANT_STATE_OVERRIDES)
    if attr.platform:
        result["//command_line_option:platforms"] = [str(attr.platform)]
    else:
        result["//command_line_option:platforms"] = settings["//command_line_option:platforms"]
    return result

_repo_transition = transition(
    implementation = _transition_impl,
    inputs = [
        "//command_line_option:platforms",
        "@golden_overlapping_conflicts__pkgs//_lock:_state",
    ],
    outputs = [
        "//command_line_option:platforms",
        "@golden_overlapping_conflicts__pkgs//_lock:_state",
    ],
)

pycross_transitioning_library_proxy = make_library_proxy_rule(cfg = _repo_transition)

pycross_transitioning_file_proxy = make_file_proxy_rule(cfg = _repo_transition)
