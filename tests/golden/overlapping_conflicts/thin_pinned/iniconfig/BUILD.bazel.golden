load("//:_transition.bzl", "pycross_transitioning_file_proxy", "pycross_transitioning_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "iniconfig",
    actual = ":pkg",
)

pycross_transitioning_library_proxy(
    name = "pkg",
    actual = "//__actual/iniconfig:pkg",
)

pycross_transitioning_file_proxy(
    name = "wheel",
    actual = "//__actual/iniconfig:wheel",
)

pycross_transitioning_file_proxy(
    name = "dist_info",
    actual = "//__actual/iniconfig:dist_info",
)

alias(
    name = "data",
    actual = ":pkg",
)
pycross_transitioning_library_proxy(
    name = "maybe",
    actual = "//__actual/iniconfig:maybe",
)

