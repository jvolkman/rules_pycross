load("@rules_pycross//pycross/private:proxy.bzl", "pycross_transitioning_file_proxy", "pycross_transitioning_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "app_lib",
    actual = ":pkg",
)

pycross_transitioning_library_proxy(
    name = "pkg",
    actual = "@golden_forks__pkgs//_lock:app-lib@1.0.0",
    platform = "//:_internal_platform",
)

pycross_transitioning_file_proxy(
    name = "wheel",
    actual = "@golden_forks__pkgs//_wheel:app-lib@1.0.0",
    platform = "//:_internal_platform",
)

pycross_transitioning_file_proxy(
    name = "dist_info",
    actual = "@golden_forks__pkgs//_lock:_dist_info_app-lib@1.0.0",
    platform = "//:_internal_platform",
)

alias(
    name = "data",
    actual = ":pkg",
)
