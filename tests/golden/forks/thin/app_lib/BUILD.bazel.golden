load("@rules_pycross//pycross/private:proxy.bzl", "pycross_transitioning_file_proxy", "pycross_transitioning_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "app_lib",
    actual = ":pkg",
)

pycross_transitioning_library_proxy(
    name = "pkg",
    actual = "@golden_forks__pkg_app_lib//:pkg",
    platform = "//:_internal_platform",
)

pycross_transitioning_file_proxy(
    name = "wheel",
    actual = "@golden_forks__pkg_app_lib//:wheel",
    platform = "//:_internal_platform",
)

pycross_transitioning_file_proxy(
    name = "dist_info",
    actual = "@golden_forks__pkg_app_lib//:dist_info",
    platform = "//:_internal_platform",
)

alias(
    name = "data",
    actual = ":pkg",
)
