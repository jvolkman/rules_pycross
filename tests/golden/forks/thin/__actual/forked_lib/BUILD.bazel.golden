package(default_visibility = ["//forked_lib:__pkg__"])

alias(
    name = "pkg",
    actual = select({
        "//_markers:is_res_py311": "@golden_forks__pkg_forked_lib//:pkg_s0",
        "//_markers:is_res_py312": "@golden_forks__pkg_forked_lib//:pkg_s1",
        "//conditions:default": "@rules_pycross//pycross/private:no_match_error",
    }),
)

alias(
    name = "wheel",
    actual = select({
        "//_markers:is_res_py311": "@golden_forks__pkg_forked_lib//:wheel_s0",
        "//_markers:is_res_py312": "@golden_forks__pkg_forked_lib//:wheel_s1",
        "//conditions:default": "@rules_pycross//pycross/private:no_match_error",
    }),
)

alias(
    name = "dist_info",
    actual = select({
        "//_markers:is_res_py311": "@golden_forks__pkg_forked_lib//:dist_info_s0",
        "//_markers:is_res_py312": "@golden_forks__pkg_forked_lib//:dist_info_s1",
        "//conditions:default": "@rules_pycross//pycross/private:no_match_error",
    }),
)

alias(
    name = "maybe",
    actual = select({
        "//_markers:is_res_py311": "//__actual/forked_lib:pkg",
        "//_markers:is_res_py312": "//__actual/forked_lib:pkg",
        "//conditions:default": "//:_empty_library",
    }),
)

