load("@rules_pycross//pycross/private:proxy.bzl", "pycross_file_proxy", "pycross_thin_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "setuptools",
    actual = ":pkg",
)

pycross_thin_library_proxy(
    name = "pkg",
    actual = "@golden_plain__pkgs//_lock:setuptools@75.0.0",
)

pycross_file_proxy(
    name = "wheel",
    actual = "@golden_plain__pkgs//_wheel:setuptools@75.0.0",
)

pycross_file_proxy(
    name = "dist_info",
    actual = "@golden_plain__pkgs//_lock:_dist_info_setuptools@75.0.0",
)

alias(
    name = "data",
    actual = ":pkg",
)
