load("@rules_pycross//pycross/private:proxy.bzl", "pycross_file_proxy", "pycross_thin_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "gamma",
    actual = ":pkg",
)

pycross_thin_library_proxy(
    name = "pkg",
    actual = "@golden_plain__pkg_gamma//:pkg",
)

pycross_file_proxy(
    name = "wheel",
    actual = "@golden_plain__pkg_gamma//:wheel",
)

pycross_file_proxy(
    name = "dist_info",
    actual = "@golden_plain__pkg_gamma//:dist_info",
)

alias(
    name = "data",
    actual = ":pkg",
)
alias(
    name = "maybe",
    actual = select({
        "@golden_plain__pkg_gamma//:_wheel_available": ":pkg",
        "//conditions:default": "//:_empty_library",
    }),
)

