load("@rules_pycross//pycross/private:proxy.bzl", "pycross_file_proxy", "pycross_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "beta",
    actual = ":pkg",
)

pycross_library_proxy(
    name = "pkg",
    actual = "@golden_plain__pkgs//_lock:beta@2.0.0",
)

pycross_file_proxy(
    name = "wheel",
    actual = "@golden_plain__pkgs//_wheel:beta@2.0.0",
)

pycross_file_proxy(
    name = "dist_info",
    actual = "@golden_plain__pkgs//_lock:_dist_info_beta@2.0.0",
)

alias(
    name = "data",
    actual = ":pkg",
)
alias(
    name = "maybe",
    actual = select({
        "@golden_plain__pkgs//_lock:_wheel_available_beta@2.0.0": ":pkg",
        "//conditions:default": "//:_empty_library",
    }),
)

