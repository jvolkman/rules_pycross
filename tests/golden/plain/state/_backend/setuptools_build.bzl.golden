"""Backend macro with pre-configured tool defaults for this lock repo."""

load("@rules_pycross//pycross/backends:setuptools.bzl", _setuptools_build = "setuptools_build")

def setuptools_build(name, **kwargs):
    if "tool_deps" not in kwargs:
        kwargs["tool_deps"] = [
            Label("@golden_plain__build//setuptools:pkg"),
        ]
    _setuptools_build(name = name, **kwargs)
