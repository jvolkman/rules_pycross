load("@rules_pycross//pycross/private:proxy.bzl", "pycross_file_proxy", "pycross_thin_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "leaf",
    actual = ":pkg",
)

pycross_thin_library_proxy(
    name = "pkg",
    actual = "@golden_cycle__pkg_leaf//:pkg",
)

pycross_file_proxy(
    name = "wheel",
    actual = "@golden_cycle__pkg_leaf//:wheel",
)

pycross_file_proxy(
    name = "dist_info",
    actual = "@golden_cycle__pkg_leaf//:dist_info",
)

alias(
    name = "data",
    actual = ":pkg",
)
