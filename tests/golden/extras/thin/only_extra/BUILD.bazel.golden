load("@rules_pycross//pycross/private:proxy.bzl", "pycross_file_proxy", "pycross_thin_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "only_extra",
    actual = ":pkg",
)

pycross_thin_library_proxy(
    name = "pkg",
    actual = "@golden_extras__pkgs//_lock:only-extra[_all_]@1.0.0",
)

pycross_file_proxy(
    name = "wheel",
    actual = "@golden_extras__pkgs//_wheel:only-extra@1.0.0",
)

pycross_file_proxy(
    name = "dist_info",
    actual = "@golden_extras__pkgs//_lock:_dist_info_only-extra@1.0.0",
)

alias(
    name = "data",
    actual = ":pkg",
)
pycross_thin_library_proxy(
    name = "[]",
    actual = "@golden_extras__pkgs//_lock:only-extra@1.0.0",
)

pycross_thin_library_proxy(
    name = "[opt]",
    actual = "@golden_extras__pkgs//_lock:only-extra[opt]@1.0.0",
)

