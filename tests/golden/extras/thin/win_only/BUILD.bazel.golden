load("@rules_pycross//pycross/private:proxy.bzl", "pycross_file_proxy", "pycross_thin_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "win_only",
    actual = ":pkg",
)

pycross_thin_library_proxy(
    name = "pkg",
    actual = "@golden_extras__pkg_win_only//:pkg",
)

pycross_file_proxy(
    name = "wheel",
    actual = "@golden_extras__pkg_win_only//:wheel",
)

pycross_file_proxy(
    name = "dist_info",
    actual = "@golden_extras__pkg_win_only//:dist_info",
)

alias(
    name = "data",
    actual = ":pkg",
)
alias(
    name = "maybe",
    actual = select({
        "//_markers:_marker_eval_sys_platform__win32_1913209870_match": ":pkg",
        "//conditions:default": "//:_empty_library",
    }),
)

