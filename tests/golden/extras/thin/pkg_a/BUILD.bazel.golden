load("@rules_pycross//pycross/private:proxy.bzl", "pycross_file_proxy", "pycross_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "pkg_a",
    actual = ":pkg",
)

pycross_library_proxy(
    name = "pkg",
    actual = "@golden_extras__pkgs//_lock:pkg-a[_all_]@1.0.0",
)

pycross_file_proxy(
    name = "wheel",
    actual = "@golden_extras__pkgs//_wheel:pkg-a@1.0.0",
)

pycross_file_proxy(
    name = "dist_info",
    actual = "@golden_extras__pkgs//_lock:_dist_info_pkg-a@1.0.0",
)

alias(
    name = "data",
    actual = ":pkg",
)
pycross_library_proxy(
    name = "[]",
    actual = "@golden_extras__pkgs//_lock:pkg-a@1.0.0",
)

pycross_library_proxy(
    name = "[cli]",
    actual = "@golden_extras__pkgs//_lock:pkg-a[cli]@1.0.0",
)

pycross_library_proxy(
    name = "[fast]",
    actual = "@golden_extras__pkgs//_lock:pkg-a[fast]@1.0.0",
)

