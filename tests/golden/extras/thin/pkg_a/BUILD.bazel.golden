load("@rules_pycross//pycross/private:proxy.bzl", "pycross_file_proxy", "pycross_library_proxy", "pycross_thin_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "pkg_a",
    actual = ":pkg",
)

pycross_library_proxy(
    name = "pkg",
    actual = "@golden_extras__pkg_pkg_a//:pkg",
    deps = [
        "@golden_extras__pkg_pkg_a//:[cli]",
        "@golden_extras__pkg_pkg_a//:[fast]",
    ],
)

pycross_file_proxy(
    name = "wheel",
    actual = "@golden_extras__pkg_pkg_a//:wheel",
)

pycross_file_proxy(
    name = "dist_info",
    actual = "@golden_extras__pkg_pkg_a//:dist_info",
)

alias(
    name = "data",
    actual = ":pkg",
)
pycross_thin_library_proxy(
    name = "[]",
    actual = "@golden_extras__pkg_pkg_a//:pkg",
)

pycross_thin_library_proxy(
    name = "[cli]",
    actual = "@golden_extras__pkg_pkg_a//:[cli]",
)

pycross_thin_library_proxy(
    name = "[fast]",
    actual = "@golden_extras__pkg_pkg_a//:[fast]",
)

