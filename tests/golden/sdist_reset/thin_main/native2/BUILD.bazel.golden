load("//:_transition.bzl", "pycross_transitioning_file_proxy", "pycross_transitioning_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "native2",
    actual = ":pkg",
)

pycross_transitioning_library_proxy(
    name = "pkg",
    actual = "@golden_sdist_reset__pkg_native2//:pkg",
)

pycross_transitioning_file_proxy(
    name = "wheel",
    actual = "@golden_sdist_reset__pkg_native2//:wheel",
)

pycross_transitioning_file_proxy(
    name = "dist_info",
    actual = "@golden_sdist_reset__pkg_native2//:dist_info",
)

alias(
    name = "data",
    actual = ":pkg",
)
pycross_transitioning_file_proxy(
    name = "sdist",
    actual = "@golden_sdist_reset__pkg_native2//:sdist",
)

