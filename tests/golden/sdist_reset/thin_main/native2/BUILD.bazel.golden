load("//:_transition.bzl", "pycross_transitioning_file_proxy", "pycross_transitioning_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "native2",
    actual = ":pkg",
)

pycross_transitioning_library_proxy(
    name = "pkg",
    actual = "@golden_sdist_reset__pkgs//_lock:native2@1.0.0",
)

pycross_transitioning_file_proxy(
    name = "wheel",
    actual = "@golden_sdist_reset__pkgs//_wheel:native2@1.0.0",
)

pycross_transitioning_file_proxy(
    name = "dist_info",
    actual = "@golden_sdist_reset__pkgs//_lock:_dist_info_native2@1.0.0",
)

alias(
    name = "data",
    actual = ":pkg",
)
pycross_transitioning_file_proxy(
    name = "sdist",
    actual = "@golden_sdist_reset__pkgs//_sdist:native2@1.0.0",
)

