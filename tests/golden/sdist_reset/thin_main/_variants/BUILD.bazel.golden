package(default_visibility = ["//visibility:public"])

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@rules_pycross//pycross/private:variant_resolver.bzl", "pycross_no_variant_selected")

selects.config_setting_group(
    name = "_selected_extra_app_cpu",
    match_any = [
        "@golden_sdist_reset__state//:is_extra_app_cpu",
        "@golden_sdist_reset__state//:_unselected_extra_app_cpu_extra_app_gpu",
    ],
)

string_flag(
    name = "_variants",
    build_setting_default = "",
)

bool_flag(
    name = "extra_cpu",
    build_setting_default = False,
)

alias(
    name = "is_extra_cpu",
    actual = ":_selected_extra_app_cpu",
)

bool_flag(
    name = "extra_gpu",
    build_setting_default = False,
)

alias(
    name = "is_extra_gpu",
    actual = "@golden_sdist_reset__state//:is_extra_app_gpu",
)

pycross_no_variant_selected(
    name = "_no_variant_extra_app_cpu_extra_app_gpu",
    message = "No uv conflict variant selected. Set one of the _variants flags on your pycross repo: extra_cpu, extra_gpu (e.g. --@golden_sdist_reset//_variants:extra_cpu=True or --@golden_sdist_reset//_variants=extra_cpu)",
)
