load("//:_transition.bzl", "pycross_transitioning_file_proxy", "pycross_transitioning_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "merged_pkg",
    actual = ":pkg",
)

pycross_transitioning_library_proxy(
    name = "pkg",
    actual = "@golden_sdist_reset__pkg_merged_pkg//:pkg",
)

pycross_transitioning_file_proxy(
    name = "wheel",
    actual = "@golden_sdist_reset__pkg_merged_pkg//:wheel",
)

pycross_transitioning_file_proxy(
    name = "dist_info",
    actual = "@golden_sdist_reset__pkg_merged_pkg//:dist_info",
)

alias(
    name = "data",
    actual = ":pkg",
)
pycross_transitioning_file_proxy(
    name = "sdist",
    actual = "@golden_sdist_reset__pkg_merged_pkg//:sdist",
)

