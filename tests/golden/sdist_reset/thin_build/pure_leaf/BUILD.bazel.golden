load("//:_transition.bzl", "pycross_transitioning_file_proxy", "pycross_transitioning_library_proxy")

package(default_visibility = ["//visibility:public"])

alias(
    name = "pure_leaf",
    actual = ":pkg",
)

pycross_transitioning_library_proxy(
    name = "pkg",
    actual = "@golden_sdist_reset__pkgs//_lock:pure-leaf@1.0.0",
)

pycross_transitioning_file_proxy(
    name = "wheel",
    actual = "@golden_sdist_reset__pkgs//_wheel:pure-leaf@1.0.0",
)

pycross_transitioning_file_proxy(
    name = "dist_info",
    actual = "@golden_sdist_reset__pkgs//_lock:_dist_info_pure-leaf@1.0.0",
)

alias(
    name = "data",
    actual = ":pkg",
)
